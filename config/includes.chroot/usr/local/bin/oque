def normaliza(s):
    return "".join(c for c in unicodedata.normalize("NFD", s.lower().strip()) if unicodedata.category(c) != "Mn")


def mostra(termo):
    o_que, exemplo, comando, veja = GLOSSARIO[termo]
    print(f"\n{AMARELO}{termo.upper()}{FIM}")
    print(f"  {o_que}")
    print(f"\n  {ROSA}Na usina:{FIM} {exemplo}")
    print(f"  {ROSA}Comando:{FIM}  {AZUL}{comando}{FIM}")
    print(f"  {CINZA}Veja tambem: " + ", ".join(f"oque {v}" for v in veja) + f"{FIM}\n")


def main():
    pedido = normaliza(" ".join(sys.argv[1:]))
    if not pedido:
        print(f"\n{AMARELO}Glossario do D'OH!Sec{FIM}  ({len(GLOSSARIO)} termos)\n")
        print("  " + ", ".join(sorted(GLOSSARIO)))
        print(f"\n{CINZA}Ex.: oque firewall   |   oque hash   |   cola (comandos por tema){FIM}\n")
        return
    if pedido in GLOSSARIO:
        return mostra(pedido)
    parecidos = [t for t in GLOSSARIO if t.startswith(pedido)] or [t for t in GLOSSARIO if pedido in t]
    if len(parecidos) == 1:
        return mostra(parecidos[0])
    if parecidos:
        print("Voce quis dizer: " + ", ".join(parecidos) + "?")
        return
    sys.exit(f"D'oh! Nao conheco '{pedido}'. Rode 'oque' para ver a lista.")


if __name__ == "__main__":
    main()
