#!/usr/bin/env python3
"""oque - glossario do D'OH!Sec OS, sem jargao.

  oque              lista os termos
  oque TERMO        explica o termo (aceita sem acento e so o comeco: oque firew)
"""
import sys
import unicodedata

AMARELO, ROSA, AZUL, CINZA, NEGRITO, FIM = ("\033[1;33m", "\033[38;5;205m", "\033[1;34m", "\033[2m",
                                            "\033[1m", "\033[0m")

