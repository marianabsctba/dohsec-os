#!/bin/bash
# dohsec-persistencia - faz a ISO live guardar o progresso entre os boots.
#
# Prepara um disco VAZIO como espaco de persistencia do Debian live (rotulo "persistence" com
# "/ union"): a partir do proximo boot, tudo o que mudar no sistema fica salvo nele.
# Por seguranca so aceita disco sem particao e sem nenhum dado, e pede confirmacao.
#   sudo dohsec-persistencia
set -euo pipefail

Y=$'\e[1;33m'; P=$'\e[38;5;205m'; V=$'\e[1;32m'; C=$'\e[2m'; N=$'\e[0m'

[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"

if [ ! -d /run/live/medium ]; then
  echo "Este sistema ja esta instalado em disco e guarda tudo sozinho. Nada a fazer."
  exit 0
fi
if grep -q " /run/live/persistence/" /proc/mounts; then
  echo "${V}A persistencia ja esta ligada:${N} seu progresso esta sendo guardado."
  exit 0
fi
if existente=$(blkid -L persistence 2>/dev/null); then
  echo "Ja existe um espaco de persistencia em ${Y}$existente${N}. Reinicie o sistema para usar."
  exit 0
fi

# Disco de onde a ISO deu boot: nunca e candidato
midia=$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)
disco_midia=$(lsblk -no PKNAME "$midia" 2>/dev/null | head -1 || true)

candidatos=()
while read -r nome tipo ro bytes; do
  [ "$tipo" = disk ] && [ "$ro" = 0 ] || continue
  [ "$bytes" -ge 1073741824 ] || continue   # menos de 1 GB (disquete, leitor vazio): nao serve
  [ "$(basename "$nome")" = "$disco_midia" ] && continue
  [ "$nome" = "$midia" ] && continue
  # Vazio de verdade: sem particoes e sem nenhuma assinatura (sistema de arquivos, tabela, RAID...)
  [ "$(lsblk -nro NAME "$nome" | wc -l)" -eq 1 ] || continue
  [ -z "$(wipefs -n "$nome" 2>/dev/null | tail -n +2)" ] || continue
  candidatos+=("$nome")
done < <(lsblk -bdnpo NAME,TYPE,RO,SIZE | grep -v -e '/dev/loop' -e '/dev/sr' -e '/dev/zram' -e '/dev/fd')

if [ ${#candidatos[@]} -eq 0 ]; then
  cat <<EOF
${P}Nenhum disco vazio encontrado.${N}

Para guardar o progresso, a maquina virtual precisa de um ${Y}segundo disco, vazio${N}:
  - VMware: desligue a VM, Edit virtual machine settings > Add > Hard Disk (8 GB ou mais)
  - VirtualBox: desligue a VM, Configuracoes > Armazenamento > adicionar disco rigido (8 GB ou mais)
Depois ligue de novo pela ISO e rode: ${Y}sudo dohsec-persistencia${N}

${C}No pendrive com Ventoy, use o plugin de persistencia do Ventoy (veja o README).${N}
EOF
  exit 1
fi

if [ ${#candidatos[@]} -eq 1 ]; then
  alvo=${candidatos[0]}
else
  echo "Discos vazios encontrados:"
  for i in "${!candidatos[@]}"; do
    printf "  %d) %s  %s\n" $((i + 1)) "${candidatos[$i]}" "$(lsblk -dno SIZE,MODEL "${candidatos[$i]}")"
  done
  read -rp "Qual usar? (numero): " n
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#candidatos[@]} ] || { echo "Cancelado."; exit 1; }
  alvo=${candidatos[$((n - 1))]}
fi

tamanho=$(lsblk -dno SIZE "$alvo" | tr -d ' ')
echo
echo "Vou preparar ${Y}$alvo${N} ($tamanho) para guardar o progresso do D'OH!Sec."
echo "Ele esta vazio, mas tudo o que estiver nele sera apagado."
read -rp "Digite SIM para continuar: " resposta
[ "$resposta" = SIM ] || { echo "Cancelado. Nada foi alterado."; exit 1; }

echo ",,L" | sfdisk --quiet --label gpt "$alvo"
udevadm settle
particao=$(lsblk -lnpo NAME,TYPE "$alvo" | awk '$2 == "part" {print $1; exit}')
mkfs.ext4 -q -F -L persistence "$particao"
montagem=$(mktemp -d)
mount "$particao" "$montagem"
echo "/ union" > "$montagem/persistence.conf"
umount "$montagem"
rmdir "$montagem"

echo
echo "${V}Pronto!${N} Reinicie (menu Iniciar > Reiniciar) e, a partir dai, seu nome, casos,"
echo "medalhas e relatorios ficam guardados. Deixe a ISO e esse disco ligados na VM."
