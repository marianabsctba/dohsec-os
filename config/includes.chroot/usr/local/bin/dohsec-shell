#!/bin/sh
# Sessao D'OH!Sec: o front do esboco e o sistema. Sobe o servico local (dohsec-api) e o
# terminal real (dohsec-pty), e abre o front em tela cheia no Firefox (modo quiosque),
# reabrindo se for fechado. Ctrl+Alt+T abre um terminal tambem por fora do front.

FRONT=http://127.0.0.1:7700/
LOGS="${XDG_RUNTIME_DIR:-/tmp}"

xset s off -dpms 2>/dev/null
xsetroot -solid "#000000" 2>/dev/null

# Gerenciador de janelas leve: o terminal do atalho e caixas de dialogo precisam de um
xfwm4 --compositor=off >/dev/null 2>&1 &
xbindkeys -f /etc/dohsec/xbindkeysrc >/dev/null 2>&1 &

# Servico local e terminal real, so em 127.0.0.1, com uma chave sorteada a cada sessao.
# O terminal so aceita conexoes da pagina do front que tenham essa chave.
# Som: na primeira sessao o volume comeca em 80% (o padrao de 40% deixa os sons do front quase
# mudos); depois o WirePlumber lembra o volume que a pessoa escolheu
MARCA_SOM="$HOME/.local/share/dohsec/volume-inicial"
if [ ! -e "$MARCA_SOM" ] && command -v wpctl >/dev/null; then
  ( sleep 5; wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.8 && wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 &&
    mkdir -p "$(dirname "$MARCA_SOM")" && touch "$MARCA_SOM" ) >/dev/null 2>&1 &
fi

DOHSEC_TOKEN=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
export DOHSEC_TOKEN
dohsec-api >"$LOGS/dohsec-api.log" 2>&1 &
dohsec-pty >"$LOGS/dohsec-pty.log" 2>&1 &

# Espera o servico responder antes de abrir o front
i=0
while [ $i -lt 40 ] && ! curl -s -o /dev/null "$FRONT"; do
  sleep 0.25
  i=$((i + 1))
done

while true; do
  firefox-esr --kiosk "$FRONT"
  # Espera o Firefox anterior sair de vez; reabrir antes disso cai numa pagina em branco
  while pgrep -u "$(id -u)" -x firefox-esr >/dev/null; do sleep 0.5; done
  sleep 1
done
