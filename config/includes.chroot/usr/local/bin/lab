#!/usr/bin/env python3
"""lab - Laboratorio Springfield: aulas de terminal e casos de resposta a incidente.

  lab                          lista as aulas, os casos e o progresso
  lab iniciar N                copia os arquivos do item N para ~/springfield/casos/ e explica
  lab dica N                   mostra a proxima dica
  lab responder N "resposta"   confere a resposta
  lab revisar N                mostra o que aprendemos (depois de resolver)
  lab zerar                    apaga o progresso
"""
import hashlib
import json
import os
import re
import shutil
import sys
from pathlib import Path

BASE = Path("/usr/share/dohsec/lab")
TRABALHO = Path.home() / "springfield" / "casos"
PROGRESSO = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "dohsec" / "lab.json"

AMARELO, ROSA, AZUL, VERDE, VERMELHO, CINZA, NEGRITO, FIM = (
    "\033[1;33m", "\033[38;5;205m", "\033[1;34m", "\033[1;32m", "\033[1;31m", "\033[2m", "\033[1m", "\033[0m")

TRILHAS = [
    ("estagiario", "Trilha do Estagiario", "aprenda o terminal"),
    ("casos", "Casos da Usina", "incidentes de verdade"),
]


def carrega_casos():
    return json.loads((BASE / "casos.json").read_text())


def carrega_progresso():
    try:
        return json.loads(PROGRESSO.read_text())
    except (OSError, ValueError):
        return {}


def salva_progresso(p):
    PROGRESSO.parent.mkdir(parents=True, exist_ok=True)
    PROGRESSO.write_text(json.dumps(p, indent=2))


def normaliza(resposta):
    return resposta.strip().strip("'\"").strip().lower()


def resolvido(prog, c):
    return prog.get(c["id"], {}).get("resolvido", False)


def acha_caso(casos, chave):
    for i, c in enumerate(casos, 1):
        if chave in (str(i), c["id"]):
            return i, c
    sys.exit(f"D'oh! '{chave}' nao existe. Rode 'lab' para ver a lista.")


def proximo(casos, prog):
    for i, c in enumerate(casos, 1):
        if not resolvido(prog, c):
            return i
    return None


def mostra_markdown(texto):
    """Markdown simples para o terminal: titulos coloridos, tabelas alinhadas, sem crases."""
    linhas = texto.splitlines()
    i = 0
    while i < len(linhas):
        linha = linhas[i]
        if linha.startswith("|"):
            tabela = []
            while i < len(linhas) and linhas[i].startswith("|"):
                celulas = [c.strip() for c in re.split(r"(?<!\\)\|", linhas[i].strip().strip("|"))]
                if not all(re.fullmatch(r"-+", c) for c in celulas):
                    tabela.append([limpa(c) for c in celulas])
                i += 1
            larguras = [max(visivel(r[k]) for r in tabela) for k in range(len(tabela[0]))]
            for n, r in enumerate(tabela):
                cor = NEGRITO if n == 0 else ""
                celulas = [c + " " * (larguras[k] - visivel(c)) for k, c in enumerate(r)]
                print("  " + cor + "   ".join(celulas) + FIM)
            continue
        if linha.startswith("# "):
            print(f"\n{AMARELO}{limpa(linha[2:])}{FIM}")
        elif linha.startswith("## "):
            print(f"\n{ROSA}{limpa(linha[3:])}{FIM}")
        else:
            print(limpa(linha))
        i += 1


def visivel(texto):
    """Largura na tela, sem contar os codigos de cor."""
    return len(re.sub(r"\033\[[0-9;]*m", "", texto))


def limpa(texto):
    texto = texto.replace("\\|", "|")
    texto = re.sub(r"\*\*(.+?)\*\*", NEGRITO + r"\1" + FIM, texto)
    return re.sub(r"`([^`]+)`", AZUL + r"\1" + FIM, texto)


def listar(casos, prog):
    total = sum(1 for c in casos if resolvido(prog, c))
    print(f"\n{AMARELO}  Laboratorio Springfield{FIM}  {CINZA}{total}/{len(casos)} concluidos{FIM}")
    for trilha, nome, sub in TRILHAS:
        itens = [(i, c) for i, c in enumerate(casos, 1) if c.get("trilha") == trilha]
        if not itens:
            continue
        feitos = sum(1 for _, c in itens if resolvido(prog, c))
        print(f"\n  {ROSA}{nome}{FIM} {CINZA}- {sub} ({feitos}/{len(itens)}){FIM}")
        for i, c in itens:
            estado = prog.get(c["id"], {})
            if estado.get("resolvido"):
                marca = f"{VERDE}concluido{FIM}"
            elif estado.get("iniciado"):
                marca = f"{AZUL}em andamento{FIM}"
            else:
                marca = f"{CINZA}novo{FIM}"
            print(f"  {AMARELO}{i:>2}{FIM}  {c['titulo']:<36} {CINZA}{c['nivel']:<6}{FIM} {marca}")
    n = proximo(casos, prog)
    if n:
        print(f"\n  Proximo passo: {AMARELO}lab iniciar {n}{FIM}\n")
    else:
        print(f"\n{AMARELO}  Tudo concluido. A usina esta segura (por hoje).{FIM}\n")


def iniciar(casos, prog, chave):
    n, c = acha_caso(casos, chave)
    destino = TRABALHO / c["id"]
    if not destino.exists():
        shutil.copytree(BASE / "casos" / c["id"], destino)
    prog.setdefault(c["id"], {})["iniciado"] = True
    salva_progresso(prog)
    mostra_markdown((destino / "LEIAME.md").read_text())
    print(f"\n{CINZA}Seus arquivos estao em:{FIM} {destino}")
    print(f"{CINZA}Para ir ate la, digite:{FIM} {AZUL}cd {destino}{FIM}")
    print(f"{CINZA}Para ler de novo esta explicacao:{FIM} {AZUL}lab iniciar {n}{FIM}\n")


def dica(casos, prog, chave):
    n, c = acha_caso(casos, chave)
    estado = prog.setdefault(c["id"], {})
    usadas = estado.get("dicas", 0)
    if usadas >= len(c["dicas"]):
        print(f"{CINZA}Acabaram as dicas. Releia a explicacao com: lab iniciar {n}{FIM}")
        usadas = len(c["dicas"]) - 1
    else:
        estado["dicas"] = usadas + 1
        salva_progresso(prog)
    print(f"{AMARELO}Dica {usadas + 1}/{len(c['dicas'])}:{FIM} {c['dicas'][usadas]}")


def mostra_aprendizado(c):
    print(f"\n  {ROSA}O que aprendemos{FIM}")
    for linha in c.get("aprendizado", []):
        print(f"  {AMARELO}*{FIM} {linha}")


def responder(casos, prog, chave, resposta):
    n, c = acha_caso(casos, chave)
    estado = prog.setdefault(c["id"], {})
    estado["tentativas"] = estado.get("tentativas", 0) + 1
    if hashlib.sha256(normaliza(resposta).encode()).hexdigest() != c["resposta"]:
        salva_progresso(prog)
        print(f"{VERMELHO}D'oh!{FIM} Nao e isso. Tente de novo ou peca uma dica: {AMARELO}lab dica {n}{FIM}")
        sys.exit(1)

    estado["resolvido"] = True
    salva_progresso(prog)
    print(f"\n{VERDE}  Mmm... resolvido!{FIM} {c['titulo']}")
    print(f"  {CINZA}tentativas: {estado['tentativas']}, dicas usadas: {estado.get('dicas', 0)}{FIM}")
    mostra_aprendizado(c)

    trilha = c.get("trilha")
    if all(resolvido(prog, x) for x in casos if x.get("trilha") == trilha):
        nome = dict((t, nome) for t, nome, _ in TRILHAS).get(trilha, trilha)
        print(f"\n{AMARELO}  {nome} concluida!{FIM}")
    n = proximo(casos, prog)
    if n:
        print(f"\n  Proximo passo: {AMARELO}lab iniciar {n}{FIM}\n")
    else:
        print(f"\n{AMARELO}  Tudo concluido. A usina esta segura (por hoje).{FIM}\n")


def revisar(casos, prog, chave):
    n, c = acha_caso(casos, chave)
    if not resolvido(prog, c):
        sys.exit(f"Resolva primeiro (lab iniciar {n}) e depois revise o que aprendeu.")
    print(f"\n{AMARELO}  {c['titulo']}{FIM}")
    mostra_aprendizado(c)
    print()


def main():
    casos = carrega_casos()
    prog = carrega_progresso()
    args = sys.argv[1:]
    if not args:
        listar(casos, prog)
    elif args[0] == "iniciar" and len(args) == 2:
        iniciar(casos, prog, args[1])
    elif args[0] == "dica" and len(args) == 2:
        dica(casos, prog, args[1])
    elif args[0] == "responder" and len(args) >= 3:
        responder(casos, prog, args[1], " ".join(args[2:]))
    elif args[0] == "revisar" and len(args) == 2:
        revisar(casos, prog, args[1])
    elif args[0] == "zerar":
        PROGRESSO.unlink(missing_ok=True)
        print("Progresso apagado. Os arquivos em ~/springfield continuam la.")
    else:
        print(__doc__.strip())
        sys.exit(2)


if __name__ == "__main__":
    main()
