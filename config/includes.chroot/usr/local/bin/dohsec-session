#!/bin/sh
# Roda no login: aplica o papel de parede em todos os monitores e abre a D'OH!Sec Academy

WALL=/usr/share/dohsec/wallpaper.png

# Espera o xfdesktop criar as propriedades de cada monitor
sleep 3
for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$'); do
  xfconf-query -c xfce4-desktop -p "$prop" -s "$WALL"
done

exec firefox-esr --new-window file:///usr/share/dohsec/academy/index.html
