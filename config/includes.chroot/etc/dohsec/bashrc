# Carregado por /etc/bash.bashrc em todo shell interativo do D'OH!Sec OS
[ -z "$PS1" ] && return

PS1='\[\e[1;33m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\] \[\e[38;5;205m\]D'"'"'oh\[\e[0m\]\$ '

command_not_found_handle() {
  printf "D'oh! '%s' nao existe nesta Springfield.\n" "$1" >&2
  return 127
}

# Historico gravado a cada comando (as Conquistas leem o ~/.bash_history; o Terminal do front
# pode ser fechado sem sair do bash)
shopt -s histappend
case "$PROMPT_COMMAND" in
  *"history -a"*) ;;
  *) PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
esac

alias academy='firefox-esr --new-window file:///usr/share/dohsec/academy/index.html >/dev/null 2>&1 &'

# Banner so no primeiro terminal da sessao
if [ -z "$DOHSEC_GREETED" ]; then
  export DOHSEC_GREETED=1
  doh
fi
